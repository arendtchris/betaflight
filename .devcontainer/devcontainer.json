{
  "name": "betaflight devcontainer",

  "build": {
    "dockerfile": "containerfile",
    "context": "."
  },

  "image": "betaflight-devcontainer:latest",

  "runArgs": [
    "--userns=host",
    "--volume=/dev:/dev"
  ],

  "hostRequirements": {
    "cpus": 4
  },

  "privileged": true,

  "remoteUser": "devpod"
}